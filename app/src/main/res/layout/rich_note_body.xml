<?xml version="1.0" encoding="utf-8"?>
<app.tessera.ui.editor.components.FlickerlessAztecText
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aztec"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="top|start"
    android:hint="@string/editor_body_hint"
    android:textColor="?attr/colorOnSurface"
    android:textColorHint="?attr/colorOnSurfaceVariant"
    android:textSize="15sp"
    android:lineSpacingExtra="4dp"
    android:textCursorDrawable="@drawable/editor_text_cursor"
    android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
    android:imeOptions="actionDone|flagNoExtractUi"
    app:historyEnable="true"
    app:historySize="20"
    app:bulletColor="@color/aztec_bullet"
    app:bulletWidth="6dp"
    app:bulletPadding="6dp"
    app:quoteColor="@color/brand_primary"
    app:quoteTextColor="@color/brand_on_surface"
    app:quoteBackground="@color/brand_primary"
    app:quoteBackgroundAlpha="8%"
    app:quoteWidth="3dp"
    app:quotePadding="12dp"
    app:quoteVerticalPadding="0dp"
    app:codeColor="@color/brand_on_surface"
    app:codeBackgroundColor="@color/brand_surface_container_high"
    app:codeBackgroundAlpha="100%"
    app:preformatColor="@color/brand_on_surface"
    app:preformatBackground="@color/brand_surface_container_high"
    app:preformatBackgroundAlpha="100%"
    app:preformatBorderColor="@android:color/transparent"
    app:preformatBorderRadius="8dp"
    app:preformatBorderThickness="0dp"
    app:preformatLeadingMargin="14dp"
    app:preformatVerticalPadding="12dp"
    app:preformatTextSize="14sp"
    app:taskListCheckedTextColor="@color/brand_on_surface_variant"
    app:paragraphVerticalMargin="0dp"
    app:blockVerticalPadding="0dp"
    app:headingVerticalPadding="0dp" />
