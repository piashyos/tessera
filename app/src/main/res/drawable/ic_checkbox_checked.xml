<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides Aztec's stock task-list checkbox: brand-colored fill with rounder corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle" android:useLevel="false">
            <corners android:radius="4dp" />
            <size android:height="24dp" android:width="24dp" />
            <solid android:color="@color/brand_primary" />
        </shape>
    </item>

    <item android:gravity="center" android:drawable="@drawable/ic_baseline_check_24" />
</layer-list>
