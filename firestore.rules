rules_version = '2';

// Правила доступа к Cloud Firestore для Tessera Notes.
// Залить их можно через Firebase Console → Firestore → вкладка «Правила»
// или командой `firebase deploy --only firestore:rules`.
//
// Тесты на эмуляторе: см. `firestore-rules-tests/` (`npm test`).
//
// Модель:
//   users/{uid}                       — публичный профиль
//   users/{uid}/notes/{noteId}        — приватные заметки (доступ только владельцу)
//   users/{uid}/folders/{folderId}    — папки (доступ только владельцу)
//   users/{uid}/tags/{tagId}          — цвет и иконка тега (docId = Base64url имени; только владельцу)
//   usersByEmail/{emailKey}           — индекс email -> uid для инвайта
//   sharedNotes/{noteId}              — общие заметки (доступ по членству/роли)
service cloud.firestore {
  match /databases/{database}/documents {

    // Публичный профиль: читать может любой залогиненный (для отображения участников),
    // писать — только сам пользователь.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/folders/{folderId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Оформление тега: docId — Base64url имени. Сброс — запись с color/icon = null, не удаление.
    match /users/{uid}/tags/{tagId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'color', 'icon', 'updatedAt'])
        && request.resource.data.name is string
        && (request.resource.data.get('color', null) == null || request.resource.data.color is string)
        && (request.resource.data.get('icon', null) == null || request.resource.data.icon is string)
        && request.resource.data.updatedAt is int;
    }

    // Индекс email -> uid. Читать может любой залогиненный (нужно для lookup при инвайте);
    // запись разрешена только в свою запись (uid в документе == uid пишущего).
    match /usersByEmail/{emailKey} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.uid;
    }

    match /sharedNotes/{noteId} {
      function myRole() {
        return resource.data.members[request.auth.uid].role;
      }
      function isMember() {
        return request.auth != null
               && request.auth.uid in resource.data.memberIds;
      }
      // Поля контента, которые вправе менять editor/manager/owner.
      function contentKeys() {
        return ['title', 'content', 'tags', 'isPinned', 'isArchived', 'updatedAt', 'deletedAt'];
      }
      function onlyContentChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(contentKeys());
      }
      // Удаление общей заметки «для всех» — это установка/снятие tombstone `deletedAt`.
      // Это полномочие manager/owner; editor может менять остальной контент, но не deletedAt.
      function touchesDeletedAt() {
        return request.resource.data.deletedAt != resource.data.deletedAt;
      }
      function membersChanged() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['members', 'memberIds']);
      }
      // Участник удаляет самого себя из members/memberIds (выход из заметки).
      // Выходящий вправе менять ТОЛЬКО ключи членства — без piggyback-правок
      // контента/deletedAt (иначе любой участник мог бы удалить заметку «для всех»).
      function leftSelf() {
        return (request.auth.uid in resource.data.memberIds)
               && !(request.auth.uid in request.resource.data.memberIds)
               && request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(['members', 'memberIds']);
      }

      allow read: if isMember();

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.members[request.auth.uid].role == 'OWNER';

      allow update: if isMember() && (
                       (onlyContentChanged()
                         && (touchesDeletedAt()
                               ? myRole() in ['OWNER', 'MANAGER']
                               : myRole() in ['OWNER', 'MANAGER', 'EDITOR']))
                       || (membersChanged() && myRole() in ['OWNER', 'MANAGER'])
                       || leftSelf()
                     );

      allow delete: if isMember() && myRole() in ['OWNER', 'MANAGER'];
    }
  }
}
